<Window x:Class="GroceryPOS.Views.PurchaseEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Entry" Width="1440" Height="800" MinWidth="760" MinHeight="520"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{DynamicResource Br_Bg}" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/orca_logo_transparent.png">
    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Br_BgHeader}"/>
            <Setter Property="Foreground" Value="{DynamicResource Br_TextDim}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Padding"    Value="8,0"/>
        </Style>

        <!-- Every figure on a line is money or a count, and those are read down the
             column by their last digit: left-aligned, 5.00 and 1250.00 start in the
             same place and agree about nothing. The header sits over the same edge as
             the digits under it, and the cell keeps the same right padding whether it
             is being read or typed in, so a cell does not shift as it is entered. -->
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Margin"              Value="0,0,8,0"/>
        </Style>
        <Style x:Key="NumEditCell" TargetType="TextBox">
            <Setter Property="TextAlignment"             Value="Right"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="Padding"                   Value="0,0,6,0"/>
        </Style>
        <Style x:Key="NumHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource HeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="📋" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDialogTitle" Text="Purchase Entry" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Br_Text}" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- What this supplier is owed overall: this is how the operator sees what that
                 figure is made of, and pays it, without
                 abandoning a half-keyed invoice to go and find out. -->
            <Button Grid.Column="1" x:Name="BtnSupplierBalances" Content="💰 SUPPLIER BALANCE" Height="34" Padding="14,0" Cursor="Hand"
                    Background="{DynamicResource Br_AmberDark}" Foreground="{DynamicResource Br_White}"
                    BorderThickness="0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                    Click="BtnSupplierBalances_Click"
                    ToolTip="Every invoice, return and payment behind this supplier's balance — and the way to pay it off."/>
        </Grid>

        <!-- Top fields -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Supplier Name" FontSize="11" Foreground="{DynamicResource Br_TextDim}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="+" Width="36" Height="36" Margin="6,0,0,0"
                            Background="{DynamicResource Br_Green}" FontWeight="Bold" FontSize="18"
                            BorderThickness="0" Cursor="Hand" ToolTip="Add a new supplier"
                            Click="BtnAddSupplier_Click"/>
                <!-- This combo carries its own ControlTemplate, so it has to name its own
                     brushes — and the ones it named were fixed dark-theme colours: Br_White
                     text on Br_Bg3. Under the Light theme Br_Bg3 is a pale grey-blue, so the supplier
                     list was white text on near-white, and the closed box was white text on
                     the white Br_InputBg — unreadable rather than merely off.

                     Everything below now uses the same tokens the rest of the app's combos
                     use, so all four themes follow: Br_InputBg / Br_Text for the closed box
                     (matching the Invoice Number and Supplier TRN boxes beside it), and
                     Br_PopupBg / Br_PopupText for the dropdown, which the shared DarkCombo
                     keeps deliberately light in every theme. -->
                <ComboBox x:Name="CboSupplier" Grid.Column="0" Style="{StaticResource DarkCombo}" Height="36" IsEditable="True"
                          Background="{DynamicResource Br_InputBg}" Foreground="{DynamicResource Br_Text}" BorderBrush="{DynamicResource Br_Border}">
                    <ComboBox.Resources>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="{DynamicResource Br_Text}"/>
                            <!-- Transparent so the one background above shows through whole. -->
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource Br_Caret}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ComboBox.Resources>
                    <ComboBox.Template>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="Bd" IsHitTestVisible="False"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                            IsReadOnly="False" Focusable="True">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Foreground"               Value="{DynamicResource Br_Text}"/>
                                                    <Setter Property="Background"               Value="Transparent"/>
                                                    <Setter Property="CaretBrush"               Value="{DynamicResource Br_Caret}"/>
                                                    <Setter Property="SelectionBrush"           Value="{DynamicResource Br_PopupSel}"/>
                                                    <Setter Property="BorderThickness"          Value="0"/>
                                                    <Setter Property="Padding"                  Value="8,0"/>
                                                    <Setter Property="Margin"                   Value="0"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="FontSize"                 Value="13"/>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Path Grid.Column="1" Data="M 0 0 L 6 6 L 12 0 Z"
                                              Fill="{DynamicResource Br_TextDim}" VerticalAlignment="Center"
                                              HorizontalAlignment="Center" Width="10" Height="6"
                                              Stretch="Fill"/>
                                    </Grid>
                                </Border>
                                <!-- AllowsTransparency False, as the shared DarkCombo popup
                                     already does: a layered window drops ClearType and leaves
                                     every supplier name soft-edged on a till screen. -->
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="False" Placement="Bottom"
                                       MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="{DynamicResource Br_PopupBg}" BorderBrush="{DynamicResource Br_Border}"
                                            BorderThickness="1" CornerRadius="0,0,3,3"
                                            MaxHeight="200"
                                            TextOptions.TextFormattingMode="Display"
                                            TextOptions.TextRenderingMode="ClearType">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Br_TextDim}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ComboBox.Template>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource Br_PopupText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <!-- Opacity rather than Br_TextDim: that token is a PALE grey
                                     in the dark themes, meant for dark surfaces, and this label
                                     sits on the light popup. There is no dim-on-popup token. -->
                                <TextBlock Grid.Column="1" Text="{Binding PhoneLabel}" Foreground="{DynamicResource Br_PopupText}" Opacity="0.65" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Br_PopupText}"/>
                            <Setter Property="Background" Value="{DynamicResource Br_PopupBg}"/>
                            <Setter Property="Padding"    Value="8,6"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="FontSize"   Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Br_PopupHover}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Br_PopupText}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Br_PopupSel}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Br_PopupText}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Invoice Number" FontSize="11" Foreground="{DynamicResource Br_TextDim}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtInvoice" Style="{StaticResource DarkTxt}" Height="36"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Pay Mode" FontSize="11" Foreground="{DynamicResource Br_TextDim}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CboPayMode" Style="{StaticResource DarkCombo}" Height="36"/>
            </StackPanel>

            <StackPanel Grid.Column="6">
                <TextBlock Text="Date" FontSize="11" Foreground="{DynamicResource Br_TextDim}" Margin="0,0,0,4"/>
                <DatePicker x:Name="DpDate" Height="36" Background="{DynamicResource Br_White}" Foreground="{DynamicResource Br_Black}"/>
            </StackPanel>

            <!-- Supplier TRN. Filled in from the supplier master when one is picked, and
                 kept on the invoice itself once saved. A purchase invoice without the
                 supplier's TRN is not a valid tax invoice, so the input VAT on it cannot
                 be reclaimed — which is why this is asked for where the invoice is keyed
                 rather than left to the supplier record nobody opens. -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                <TextBlock Text="Supplier TRN" FontSize="11" Foreground="{DynamicResource Br_TextDim}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtSupplierTrn" Style="{StaticResource DarkTxt}" Height="36" MaxLength="20"
                         TextChanged="TxtSupplierTrn_Changed"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="5" x:Name="TxtTrnHint" Margin="0,28,0,0"
                       FontSize="10" Foreground="{DynamicResource Br_TextMuted}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="A UAE TRN is 15 digits. Leave blank if the supplier is not VAT-registered."/>
        </Grid>

        <!-- Line items header -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Line Items" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Br_Text}" VerticalAlignment="Center"/>
            <!-- Goods arriving that the shop has never stocked are common on a delivery, and
                 leaving the invoice to go and create the product loses the half-typed invoice.
                 This creates it here, on the full product form, and drops it onto a line. -->
            <Button x:Name="BtnNewProduct" Grid.Column="1" Content="➕ New Product" Background="{DynamicResource Br_GreenDark}" Foreground="{DynamicResource Br_White}"
                    FontWeight="Bold" BorderThickness="0" Height="34" Padding="14,0" Margin="0,0,6,0" Cursor="Hand" Click="BtnNewProduct_Click"
                    ToolTip="Create a product that is not in the catalogue yet and put it on this invoice. It is saved to the product list straight away, with the category, unit, cost and selling price you give it."/>
            <Button Grid.Column="2" Content="+ Add Item" Background="{DynamicResource Br_Teal}" FontWeight="Bold" BorderThickness="0" Height="34" Padding="14,0" Margin="0,0,6,0" Cursor="Hand" Click="BtnAddItem_Click"/>
            <Button Grid.Column="3" Content="🗑 Remove" Background="{DynamicResource Br_Steel}" FontWeight="Bold" BorderThickness="0" Height="34" Padding="14,0" Cursor="Hand" Click="BtnRemoveItem_Click"/>
        </Grid>

        <!-- Items grid + Notes + Totals -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <!-- Items grid -->
            <DataGrid Grid.Row="0" Grid.Column="0" x:Name="ItemsGrid"
                      Background="{DynamicResource Br_Bg2}" Foreground="{DynamicResource Br_Text}" BorderBrush="{DynamicResource Br_Border}"
                      RowBackground="{DynamicResource Br_Bg2}" AlternatingRowBackground="{DynamicResource Br_Bg3}"
                      HorizontalGridLinesBrush="{DynamicResource Br_Border}" VerticalGridLinesBrush="{DynamicResource Br_Border}"
                      AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                      ColumnHeaderHeight="34" FontSize="12"
                      ColumnHeaderStyle="{StaticResource HeaderStyle}"
                      PreviewMouseLeftButtonDown="ItemsGrid_PreviewMouseLeftButtonDown"
                      PreviewKeyDown="ItemsGrid_PreviewKeyDown"
                      PreparingCellForEdit="ItemsGrid_PreparingCellForEdit">
                <DataGrid.Columns>
                    <!-- Item Name first, then the code. The invoice is read against the
                         supplier's own paperwork, which lists what was delivered by name —
                         so the name is the column the eye lands on, and the code is the
                         identifier beside it. Scanning still works wherever the caret is:
                         the scanner types into the Barcode cell and Enter resolves it.
                         Cost and Retail sit side by side, the one moment both figures are
                         in front of somebody at once. -->
                    <DataGridTemplateColumn Header="Item Name" Width="*" MinWidth="200" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox x:Name="ItemBox"
                                             Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             Background="Transparent" Foreground="{DynamicResource Br_Text}" CaretBrush="{DynamicResource Br_Caret}"
                                             SelectionBrush="{DynamicResource Br_Border}" BorderThickness="0" Padding="6,0"
                                             VerticalContentAlignment="Center" FontSize="12"
                                             TextChanged="ItemBox_TextChanged"
                                             GotKeyboardFocus="ItemBox_GotFocus"
                                             LostKeyboardFocus="ItemBox_LostFocus"
                                             PreviewMouseLeftButtonDown="ItemBox_PreviewMouseDown"
                                             PreviewKeyDown="ItemBox_KeyDown"/>
                                    <Popup x:Name="ItemPopup" PlacementTarget="{Binding ElementName=ItemBox}"
                                           Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                                           Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
                                        <Border Background="{DynamicResource Br_Bg3}" BorderBrush="{DynamicResource Br_Border}" BorderThickness="1" CornerRadius="0,0,3,3" MaxHeight="240">
                                            <!-- Each row carries the name AND the code. DisplayMemberPath="Name"
                                                 showed the name alone, which is the one thing that cannot tell two
                                                 deliveries of the same goods apart: a shop stocking the same rice
                                                 in two pack sizes reads the same word twice and picks blind. The
                                                 code beside it also says at a glance which products still have
                                                 none and want the 🎲 on the line. -->
                                            <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource Br_Text}"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     SelectionChanged="ItemList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       Foreground="{DynamicResource Br_Text}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <!-- Monospaced so the codes line up as a column the eye
                                                                 can run down, not ragged proportional digits. -->
                                                            <TextBlock Grid.Column="1" Text="{Binding Barcode}"
                                                                       Visibility="{Binding HasBarcode, Converter={StaticResource BoolToVis}}"
                                                                       Foreground="{DynamicResource Br_TextDim}" FontFamily="Consolas"
                                                                       FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                            <!-- Said in words rather than left blank: an empty right
                                                                 edge reads as a rendering fault, and this is exactly
                                                                 the product that would otherwise be created with an
                                                                 invented code. A DataTrigger, not the BoolToVis
                                                                 converter with a parameter — that converter ignores
                                                                 its parameter, so an "invert" would silently show
                                                                 this label on top of every real code. -->
                                                            <TextBlock Grid.Column="1" Text="no barcode"
                                                                       Foreground="{DynamicResource Br_TextMuted}" FontSize="10" FontStyle="Italic"
                                                                       Margin="12,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasBarcode}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Foreground" Value="{DynamicResource Br_Text}"/>
                                                        <Setter Property="Padding"    Value="8,6"/>
                                                        <Setter Property="FontSize"   Value="13"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Br_Border}"/></Trigger>
                                                                        <Trigger Property="IsSelected"  Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Br_Border}"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Barcode" Width="200" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                         Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Background="Transparent" Foreground="{DynamicResource Br_Text}" CaretBrush="{DynamicResource Br_Caret}"
                                         SelectionBrush="{DynamicResource Br_Border}" BorderThickness="0" Padding="6,0"
                                         VerticalContentAlignment="Center" FontSize="12"
                                         GotKeyboardFocus="BarcodeBox_GotFocus"
                                         PreviewMouseLeftButtonDown="BarcodeBox_PreviewMouseDown"
                                         PreviewKeyDown="BarcodeBox_KeyDown"
                                         LostKeyboardFocus="BarcodeBox_LostFocus"
                                         ToolTip="Scan or type the product's barcode and press Enter. An unknown code offers to create the product."/>
                                    <!-- Goods with no printed code at all — loose sacks, a local
                                         supplier's own packing — need a code of the shop's own
                                         before a shelf label can be printed for them. -->
                                    <Button Grid.Column="1" Content="🎲" Width="28" Height="24" Margin="2,0,2,0"
                                            Background="{DynamicResource Br_GreenDark}" Foreground="{DynamicResource Br_White}"
                                            BorderThickness="0" FontSize="12" Padding="0" Cursor="Hand"
                                            Click="BtnGenLineBarcode_Click"
                                            ToolTip="Generate an in-store barcode for a product that has none printed on it."/>
                                    <!-- ...and printing it is the point of generating one. The
                                         stickers are wanted while the delivery is open on the
                                         counter, not after a trip to the Products tab. -->
                                    <Button Grid.Column="2" Content="🏷" Width="28" Height="24" Margin="0,0,2,0"
                                            Background="{DynamicResource Br_BlueDark}" Foreground="{DynamicResource Br_White}"
                                            BorderThickness="0" FontSize="12" Padding="0" Cursor="Hand"
                                            Click="BtnPrintLineLabel_Click"
                                            ToolTip="Print barcode stickers for this line — the quantity received is filled in for you."/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Quantity"     Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="85" ElementStyle="{StaticResource NumCell}" EditingElementStyle="{StaticResource NumEditCell}" HeaderStyle="{StaticResource NumHeaderStyle}"/>
                    <!-- "Cost Price", not "Rate". The figure never changed, but the header
                         now says which side of the trade it is, next to the retail one. -->
                    <DataGridTextColumn Header="Cost Price"   Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="95" ElementStyle="{StaticResource NumCell}" EditingElementStyle="{StaticResource NumEditCell}" HeaderStyle="{StaticResource NumHeaderStyle}"/>
                    <!-- Retail takes no part in the totals to its right: the invoice is
                         settled at cost. It is here because keying the delivery is when the
                         cost is known and the shelf price is worth deciding. -->
                    <DataGridTextColumn Header="Retail Price" Binding="{Binding RetailPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="100" ElementStyle="{StaticResource NumCell}" EditingElementStyle="{StaticResource NumEditCell}" HeaderStyle="{StaticResource NumHeaderStyle}"/>
                    <DataGridTextColumn Header="Tax (%)"      Binding="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="75" ElementStyle="{StaticResource NumCell}" EditingElementStyle="{StaticResource NumEditCell}" HeaderStyle="{StaticResource NumHeaderStyle}"/>
                    <DataGridTextColumn Header="Net"          Binding="{Binding Net, StringFormat=N2}"   Width="95"  IsReadOnly="True" ElementStyle="{StaticResource NumCell}" EditingElementStyle="{StaticResource NumEditCell}" HeaderStyle="{StaticResource NumHeaderStyle}"/>
                    <DataGridTextColumn Header="Tax"          Binding="{Binding Tax, StringFormat=N2}"   Width="90"  IsReadOnly="True" ElementStyle="{StaticResource NumCell}" EditingElementStyle="{StaticResource NumEditCell}" HeaderStyle="{StaticResource NumHeaderStyle}"/>
                    <DataGridTextColumn Header="Total"        Binding="{Binding Total, StringFormat=N2}" Width="105" IsReadOnly="True" ElementStyle="{StaticResource NumCell}" EditingElementStyle="{StaticResource NumEditCell}" HeaderStyle="{StaticResource NumHeaderStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Notes -->
            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Text="Notes" FontSize="11" Foreground="{DynamicResource Br_TextDim}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNotes" Background="{DynamicResource Br_Bg2}" Foreground="{DynamicResource Br_Text}" BorderBrush="{DynamicResource Br_Border}"
                         BorderThickness="1" Padding="10,8" FontSize="12" Height="110"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Totals panel -->
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Background="{DynamicResource Br_Bg2}" BorderBrush="{DynamicResource Br_Border}" BorderThickness="1" CornerRadius="6" Padding="16,14" VerticalAlignment="Bottom">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                    <!-- Items total, then the discount, then the taxable subtotal. Spelling all
                         three out is what lets this be checked against the foot of the supplier's
                         own invoice, and it shows VAT being charged on the discounted figure
                         rather than the list one. -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Items Total" Foreground="{DynamicResource Br_TextDim}" FontSize="12"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtItemsTotal" Text="AED 0.00" Foreground="{DynamicResource Br_Text}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>

                    <!-- ONE discount for the whole invoice, keyed here rather than line by line:
                         a supplier states a trade discount at the foot of the bill, so keying it
                         once is both what the invoice says and one figure to check instead of
                         twenty. The unit button switches between a percentage of the items total
                         and a flat amount off it; the row beneath shows the money it takes off,
                         which is what the supplier's own total has to agree with. -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount" Foreground="{DynamicResource Br_TextDim}" FontSize="12" Margin="0,10,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="BtnDiscUnit" Content="%" Width="36" Height="30" Cursor="Hand"
                                Background="{DynamicResource Br_Steel}" Foreground="{DynamicResource Br_White}"
                                BorderThickness="0" FontSize="12" FontWeight="Bold" Padding="0"
                                Click="BtnDiscUnit_Click"
                                ToolTip="Tap to switch between a percentage of the items total and a flat amount off it."/>
                        <TextBox x:Name="TxtDiscInput" Width="80" Height="30" Margin="4,0,0,0"
                                 Background="{DynamicResource Br_Bg3}" Foreground="{DynamicResource Br_Text}" BorderBrush="{DynamicResource Br_Border}" BorderThickness="1"
                                 Padding="8,4" FontSize="13" FontWeight="Bold" TextAlignment="Right" Text="0"
                                 TextChanged="TxtDisc_Changed" GotKeyboardFocus="TxtDisc_GotFocus"
                                 ToolTip="The discount the supplier gave on this whole invoice. It is shared out over the lines in proportion to what each one is worth."/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Discount Given" Foreground="{DynamicResource Br_TextDim}" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDiscount" Text="AED 0.00" Foreground="{DynamicResource Br_Green}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Subtotal (taxable)" Foreground="{DynamicResource Br_TextDim}" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtSubtotal" Text="AED 0.00" Foreground="{DynamicResource Br_Text}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="VAT / Tax" Foreground="{DynamicResource Br_TextDim}" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtVat"      Text="AED 0.00" Foreground="{DynamicResource Br_Text}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Grand Total" Foreground="{DynamicResource Br_Teal}" FontSize="13" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtGrand"   Text="AED 0.00" Foreground="{DynamicResource Br_Teal}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Amount Paid" Foreground="{DynamicResource Br_TextDim}" FontSize="12" Margin="0,10,0,0" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TxtPaid" Width="120" Height="30" Margin="0,10,0,0"
                               Background="{DynamicResource Br_Bg3}" Foreground="{DynamicResource Br_Text}" BorderBrush="{DynamicResource Br_Border}" BorderThickness="1"
                               Padding="8,4" FontSize="13" FontWeight="Bold" TextAlignment="Right" Text="0.00"
                               TextChanged="TxtPaid_Changed"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Balance" Foreground="{DynamicResource Br_Amber}" FontSize="13" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtBal" Text="AED 0.00" Foreground="{DynamicResource Br_Amber}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="CANCEL" Width="130" Height="40" Background="{DynamicResource Br_Steel}" BorderThickness="0" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"
                    Click="BtnCancel_Click"/>
            <Button Grid.Column="2" Content="💾  SAVE" Width="170" Height="40" Background="{DynamicResource Br_Green}" BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                    Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</Window>
